# Legal Metrology Compliance Platform - Environment Variables

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Backend realtime inspection
CORS_ALLOWED_ORIGINS=http://localhost:3000
OCR_PROVIDER=tesseract
DETECTION_PROVIDER=demo

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_ANALYSIS=true
NEXT_PUBLIC_ENABLE_PDF_EXPORT=true
NEXT_PUBLIC_ENABLE_CAMERA_CAPTURE=true

# Government Branding
NEXT_PUBLIC_MINISTRY_NAME="Ministry of Consumer Affairs"
NEXT_PUBLIC_DEPARTMENT_NAME="Legal Metrology"
